# Nalpamaradi Keram RAG System - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== API KEYS =====
GROQ_API_KEY=your_groq_api_key_here

# ===== MODEL CONFIGURATION =====
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=llama-3.3-70b-versatile

# ===== CHUNKING SETTINGS =====
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MIN_CHUNK_LENGTH=50

# ===== RETRIEVAL SETTINGS =====
TOP_K_RETRIEVAL=5
BM25_CANDIDATES=50
SIMILARITY_THRESHOLD=0.3

# ===== AGENT SETTINGS =====
MAX_RETRIES=2
OUTLINE_TEMPERATURE=0.5
WRITER_TEMPERATURE=0.4
FACT_CHECK_TEMPERATURE=0.2

# ===== OCR SETTINGS =====
OCR_ENABLED=True
OCR_MIN_TEXT_LENGTH=30

# ===== PRODUCT INFO =====
PRODUCT_NAME=Nalpamaradi Keram
BRAND_NAME=Kerala Ayurveda